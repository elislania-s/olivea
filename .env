# ======================================
# Copie este arquivo para ".env" (sem o
# ".example") e preencha com seus dados
# reais. O arquivo ".env" NUNCA deve ser
# publicado no GitHub nem enviado a
# ninguém — é ele que guarda sua chave
# secreta do Mercado Pago.
# ======================================

# Access Token da sua conta Mercado Pago.
# Pegue em: https://www.mercadopago.com.br/developers/panel
# Comece com o token de TESTE (começa com TEST-...) e só
# troque pelo de produção quando for lançar de verdade.
MP_ACCESS_TOKEN=TEST-SEU-ACCESS-TOKEN-AQUI

# Endereço público do SITE (onde estão as páginas do Olivea,
# incluindo pagamento-sucesso.html etc). Sem "/" no final.
URL_DO_SITE=https://www.oliveasemijoias.com.br

# Endereço público deste SERVIDOR (onde o server.js está
# hospedado). É pra cá que o Mercado Pago manda o aviso de
# pagamento aprovado. Sem "/" no final.
URL_DO_SERVIDOR=https://olivea-servidor.onrender.com

# Porta local (não precisa mexer, a maioria dos serviços de
# hospedagem define isso sozinha)
PORT=3000
